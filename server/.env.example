# Copy to .env.local and fill in your local database password.
# start-local.ps1 loads .env.local; Spring Boot itself does not load it.
# Local file values override environment variables for this launch only.
# Values are literal (no variable expansion); optional surrounding quotes are removed.
# Put comments on separate lines. Use quotes to preserve leading/trailing spaces.
JAVA_HOME=D:\Java
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/ailearning?connectionTimeZone=UTC&characterEncoding=UTF-8
DB_USERNAME=ailearning_app
DB_PASSWORD=
SESSION_COOKIE_SECURE=false
# HTTPS production: SESSION_COOKIE_SECURE=true
# First administrator: use start-local.ps1 -InitializeAdmin; never put its password here.

# AI tutor: set AI_CHAT_PROVIDER=deepseek and add your key in .env.local.
# Keep none when AI is not configured; existing learning/login still work.
AI_CHAT_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_MAX_TOKENS=512
AI_MAX_CONTEXT_CHARS=6000
AI_MAX_MESSAGE_CHARS=1000
AI_MAX_HISTORY_MESSAGES=4
AI_TIMEOUT_SECONDS=60
